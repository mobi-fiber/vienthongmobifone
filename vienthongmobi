function openRegister(packageName) {* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #222;
    background: #fff;
    line-height: 1.6;
}

.container {
    width: min(1180px, 92%);
    margin: auto;
}


/* ================= HEADER ================= */

.header {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
}

.header-content {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo-mobifone {
    font-size: 32px;
    font-weight: 900;
    color: #0095d9;
    letter-spacing: -2px;
}

.header-button {
    text-decoration: none;
    background: #009fe3;
    color: #fff;
    padding: 12px 22px;
    border-radius: 30px;
    font-weight: bold;
}


/* ================= HERO ================= */

.hero {
    min-height: 650px;
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(
            circle at 75% 30%,
            rgba(0,180,255,.35),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #001d4d,
            #0069a9,
            #00a6e8
        );
}

.hero::before {
    content: "";
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    right: -150px;
    top: -100px;
}

.hero-content {
    position: relative;
    z-index: 2;
    padding-top: 85px;
    padding-bottom: 70px;
    color: white;
}

.hero-badge {
    display: inline-block;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.4);
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -2px;
}

.hero h1 span {
    color: #ffe600;
}

.hero-subtitle {
    font-size: 28px;
    margin-top: 18px;
    font-weight: 600;
}

.promotion {
    margin-top: 30px;
    max-width: 600px;
    background: rgba(0,0,0,.2);
    border: 1px solid rgba(255,255,255,.25);
    padding: 24px;
    border-radius: 20px;
    backdrop-filter: blur(10px);
}

.promotion-small {
    color: #ffe600;
    font-weight: bold;
    font-size: 14px;
}

.promotion-title {
    font-size: 38px;
    line-height: 1.1;
    font-weight: 900;
    margin-top: 6px;
}

.promotion-text {
    font-size: 21px;
    font-weight: bold;
}

.price-highlight {
    margin-top: 15px;
    font-size: 18px;
}

.price-highlight strong {
    display: block;
    font-size: 30px;
    color: #ffe600;
}

.hero-buttons {
    margin-top: 30px;
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;
    text-decoration: none;
    padding: 15px 28px;
    border-radius: 40px;
    font-weight: 800;
    transition: .25s;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn-primary {
    background: #ffe600;
    color: #111;
}

.btn-outline {
    border: 2px solid white;
    color: white;
}

.btn-white {
    background: white;
    color: #0076b6;
}


/* ================= SECTION ================= */

section {
    padding: 80px 0;
}

.section-title {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 50px;
}

.section-title span,
.register-text span,
.promotion-content span {
    color: #009fe3;
    font-weight: 800;
    font-size: 14px;
}

.section-title h2 {
    font-size: 38px;
    line-height: 1.2;
    margin: 8px 0 12px;
}


/* ================= BENEFITS ================= */

.benefits {
    background: #f6fbff;
}

.benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.benefit-card {
    background: white;
    padding: 30px 22px;
    border-radius: 18px;
    text-align: center;
    box-shadow: 0 8px 25px rgba(0,70,120,.08);
    transition: .25s;
}

.benefit-card:hover {
    transform: translateY(-7px);
}

.benefit-icon {
    font-size: 42px;
    margin-bottom: 15px;
}

.benefit-card h3 {
    margin-bottom: 10px;
}


/* ================= PACKAGES ================= */

.packages {
    background: white;
}

.package-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.package-card {
    position: relative;
    background: white;
    border: 1px solid #e5edf3;
    border-radius: 22px;
    padding: 30px 25px;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0,80,130,.08);
    transition: .3s;
}

.package-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0,100,170,.15);
}

.package-card.popular {
    border: 3px solid #009fe3;
}

.popular-label {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: #009fe3;
    color: white;
    padding: 5px 18px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.package-tag {
    display: inline-block;
    background: #e8f8ff;
    color: #0079b5;
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: bold;
    font-size: 13px;
}

.package-tag.yearly {
    background: #fff5d9;
    color: #d78b00;
}

.package-card h3 {
    font-size: 24px;
    margin: 18px 0;
}

.speed {
    color: #006fa8;
}

.speed strong {
    font-size: 55px;
    font-weight: 900;
    line-height: 1;
}

.speed {
    font-size: 20px;
    font-weight: bold;
}

.duration {
    margin-top: 18px;
    color: #666;
}

.duration b {
    color: #009fe3;
}

.package-price {
    margin-top: 20px;
    color: #111;
    font-size: 28px;
    font-weight: 900;
}

.package-price span {
    font-size: 17px;
}

.average {
    color: #008b58;
    font-weight: bold;
    margin-top: 4px;
}

.package-button {
    width: 100%;
    margin-top: 22px;
    padding: 13px;
    border: none;
    border-radius: 30px;
    background: #009fe3;
    color: white;
    font-weight: 800;
    cursor: pointer;
    transition: .2s;
}

.package-button:hover {
    background: #007bb3;
    transform: translateY(-2px);
}


/* ================= PROMOTION SECTION ================= */

.promotion-section {
    background:
        linear-gradient(
            135deg,
            #0078b7,
            #00a8e8
        );
    color: white;
}

.promotion-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
}

.promotion-content span {
    color: #ffe600;
}

.promotion-content h2 {
    font-size: 42px;
    line-height: 1.15;
    margin: 10px 0;
}

.promotion-content p {
    max-width: 650px;
}


/* ================= REGISTER ================= */

.register {
    background: #f5faff;
}

.register-box {
    background: white;
    border-radius: 25px;
    padding: 50px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    box-shadow: 0 10px 35px rgba(0,70,120,.1);
}

.register-text h2 {
    font-size: 38px;
    line-height: 1.2;
    margin: 8px 0 15px;
}

.form-group {
    margin-bottom: 17px;
}

.form-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 7px;
}

.form-group input,
.form-group select {
    width: 100%;
    padding: 14px 15px;
    border: 1px solid #d8e3ea;
    border-radius: 10px;
    font-size: 16px;
    outline: none;
}

.form-group input:focus,
.form-group select:focus {
    border-color: #009fe3;
}

.submit-button {
    width: 100%;
    border: none;
    padding: 15px;
    border-radius: 30px;
    background: #009fe3;
    color: white;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
}


/* ================= FOOTER ================= */

.footer {
    background: #071b2b;
    color: white;
    padding: 55px 0 25px;
    text-align: center;
}

.footer-logo {
    color: #00a8e8;
    font-size: 34px;
    font-weight: 900;
}

.footer h3 {
    margin-top: 10px;
}

.footer-contact {
    display: flex;
    justify-content: center;
    gap: 70px;
    margin: 35px 0;
}

.footer-contact span {
    color: #9db1c0;
}

.copyright {
    border-top: 1px solid rgba(255,255,255,.1);
    padding-top: 20px;
    color: #8499a8;
    font-size: 13px;
}


/* ================= MODAL ================= */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.65);
    display: none;
    justify-content: center;
    align-items: center;
    padding: 20px;
    z-index: 2000;
}

.modal.active {
    display: flex;
}

.modal-content {
    background: white;
    width: min(450px, 100%);
    border-radius: 22px;
    padding: 40px;
    text-align: center;
    position: relative;
}

.modal-close {
    position: absolute;
    right: 18px;
    top: 10px;
    border: none;
    background: none;
    font-size: 35px;
    cursor: pointer;
}

.modal-icon {
    width: 65px;
    height: 65px;
    margin: auto;
    border-radius: 50%;
    background: #e7f9f0;
    color: #00a060;
    font-size: 40px;
    line-height: 65px;
}

.modal-content h2 {
    margin-top: 20px;
}

.modal-content strong {
    color: #009fe3;
    font-size: 25px;
}

.modal-note {
    margin-top: 20px;
    color: #777;
}


/* ================= MOBILE ================= */

@media (max-width: 900px) {

    .benefit-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .package-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .register-box {
        grid-template-columns: 1fr;
    }

    .promotion-content {
        flex-direction: column;
        align-items: flex-start;
    }

}


@media (max-width: 600px) {

    .header-content {
        min-height: 65px;
    }

    .logo-mobifone {
        font-size: 25px;
    }

    .header-button {
        padding: 9px 14px;
        font-size: 12px;
    }

    .hero {
        min-height: auto;
    }

    .hero-content {
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .hero h1 {
        font-size: 43px;
    }

    .hero-subtitle {
        font-size: 21px;
    }

    .promotion-title {
        font-size: 28px;
    }

    .promotion-text {
        font-size: 17px;
    }

    .price-highlight strong {
        font-size: 25px;
    }

    section {
        padding: 60px 0;
    }

    .section-title h2 {
        font-size: 29px;
    }

    .benefit-grid {
        grid-template-columns: 1fr;
    }

    .package-grid {
        grid-template-columns: 1fr;
    }

    .package-card {
        padding: 28px 20px;
    }

    .promotion-content h2 {
        font-size: 31px;
    }

    .register-box {
        padding: 28px 20px;
        gap: 30px;
    }

    .register-text h2 {
        font-size: 30px;
    }

    .footer-contact {
        flex-direction: column;
        gap: 20px;
    }

}

